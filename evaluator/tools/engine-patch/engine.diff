                         tape.Add(new Dictionary<string, uint> { ["branch"] = req.GetProperty("salt").GetUInt32() });
                         Time("branch", sw);
                     }
+                    else if (op == "set_player")
+                    {
+                        // 確認用（STS2 Stats の試作）：{"op":"set_player","snapshot":"<Snapshot.Player の JSON>"}。第 1 幕は act_start で始められないので、
+                        // 通常の開局の直後に玩家の状態だけを置き換える。持っている遺物は ActStart.Start と同じく遺物袋から外す。
+                        if (run == null) throw new InvalidOperationException("尚未 reset");
+                        var st = RunSession.State;
+                        var me = st.Players[0];
+                        Snapshot.Restore(me, req.GetProperty("snapshot").GetString()!);
+                        foreach (var r in me.Relics) { me.RelicGrabBag.Remove(r); st.SharedRelicGrabBag.Remove(r); }
+                        Time("set_player", sw);
+                    }
+                    else if (op == "offer_cards")
+                    {
+                        // 確認用（STS2 Stats の試作）：{"op":"offer_cards","cards":[{"id":"STAMPEDE","upgrades":1},…]}。
+                        // 指定したカードのカード報酬を、ゲームのチュートリアル用のコンストラクタで作って開く。返すのはそのカード報酬の判断の観測。
+                        if (run == null) throw new InvalidOperationException("尚未 reset");
+                        var st = RunSession.State;
+                        var me = st.Players[0];
+                        var cards = new List<MegaCrit.Sts2.Core.Models.CardModel>();
+                        foreach (var x in req.GetProperty("cards").EnumerateArray())
+                        {
+                            var card = st.CreateCard(MegaCrit.Sts2.Core.Models.ModelDb.GetById<MegaCrit.Sts2.Core.Models.CardModel>(
+                                new MegaCrit.Sts2.Core.Models.ModelId("CARD", Snapshot.RenamedCard(x.GetProperty("id").GetString()!))), me);
+                            int up = x.TryGetProperty("upgrades", out var u) ? u.GetInt32() : 0;
+                            for (int i = 0; i < Math.Min(up, card.MaxUpgradeLevel); i++) { card.UpgradeInternal(); card.FinalizeUpgradeInternal(); }
+                            cards.Add(card);
+                        }
+                        var opts = new MegaCrit.Sts2.Core.Runs.CardCreationOptions(Array.Empty<MegaCrit.Sts2.Core.Models.CardPoolModel>(),
+                            MegaCrit.Sts2.Core.Runs.CardCreationSource.Encounter, MegaCrit.Sts2.Core.Runs.CardRarityOddsType.RegularEncounter);
+                        var reward = new MegaCrit.Sts2.Core.Rewards.CardReward(cards, MegaCrit.Sts2.Core.Runs.CardCreationSource.Encounter, me, opts);
+                        reward.Populate();
+                        Pump.Instance.Start(() => reward.SelectUnsynchronized());
+                        Pump.Instance.RunUntilIdle();
+                        Time("offer_cards", sw);
+                    }
+                    else if (op == "stats_tables")
+                    {
+                        // 確認用（STS2 Stats の試作）：サーバー側の変換が使う表を書き出す
+                        if (run == null) throw new InvalidOperationException("尚未 reset");
+                        Observation.DumpStatsTables(req.GetProperty("path").GetString()!);
+                    }
+                    else if (op == "stats_facts")
+                    {
+                        // 確認用（STS2 Stats の試作）：今の判断の局面の事実を書き出す
+                        if (run == null || decision == null) throw new InvalidOperationException("尚未 reset");
+                        Observation.AppendStatsFacts(req.GetProperty("path").GetString()!, decision);
+                    }
                     else throw new ArgumentException("未知操作 " + op);
                     decision = run!.GetDecision();
                     // 只有一个候选的决策由引擎自己走过（局面复制方案 C2，请求带 "auto_single":true 时）：不编码、不回 Python，
